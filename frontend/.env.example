# URL ของ Backend เมื่อรัน Frontend แยกในเครื่อง
VITE_API_URL=http://localhost:3000

# ใช้ Client ID ตัวเดียวกับ GOOGLE_CLIENT_ID ใน backend/.env
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# เปิดเฉพาะเมื่อต้องการทดสอบในเครื่องโดยไม่ใช้ Google Sign-In
# ต้องเปิด ENABLE_DEV_LOGIN ใน backend/.env พร้อมกัน และห้ามเปิดใน Production
VITE_ENABLE_DEV_LOGIN=false
