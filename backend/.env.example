DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/grad_tracking
PORT=3000
# Database และพอร์ตของ Backend อยู่ด้านบน (ต้องแก้ DATABASE_URL เมื่อเปลี่ยนฐานข้อมูล)

# Authentication และ Google SSO (ต้องแก้เมื่อเปลี่ยน Environment หรือ Google OAuth Client)
ENABLE_DEV_LOGIN=false
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
JWT_SECRET=replace_with_a_long_random_secret
AUTH_COOKIE_SAME_SITE=lax

# URL ระหว่าง Frontend และ Backend (ต้องแก้เมื่อเปลี่ยน Domain หรือ Port)
FRONTEND_ORIGIN=http://localhost:5173
PUBLIC_API_URL=http://localhost:3000

# Gmail SMTP (ต้องแก้เมื่อเปลี่ยนบัญชีผู้ส่ง Email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_STARTTLS=false
SMTP_USER=your_sender@gmail.com
SMTP_PASS=your_16_character_app_password
SMTP_FROM="GRAD Tracking <your_sender@gmail.com>"

# Timezone ของระบบ (ต้องแก้เมื่อ Deploy ไปยังพื้นที่เวลาที่ต่างออกไป)
TZ=Asia/Bangkok

# Email test mode: ส่ง Email ทั้งหมดมาที่บัญชีทดสอบเพียงบัญชีเดียว (ต้องแก้อันนี้เมื่อเปลี่ยนบัญชีผู้รับทดสอบ)
EMAIL_TEST_MODE=true
EMAIL_TEST_RECIPIENT=your_test_recipient@gmail.com

# Bootstrap Admin (ต้องแก้อันนี้เมื่อเปลี่ยนบัญชีผู้ดูแลระบบ)
BOOTSTRAP_ADMIN_EMAIL=your_admin@lamduan.mfu.ac.th
BOOTSTRAP_ADMIN_NAME=System Administrator
