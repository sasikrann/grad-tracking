DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/grad_tracking
PORT=3000
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
JWT_SECRET=replace_with_a_long_random_secret
# Use none only when frontend and backend are on different sites (requires HTTPS)
AUTH_COOKIE_SAME_SITE=lax
# Development login bypass (keep disabled while Google Sign-In is active)
# ENABLE_DEV_LOGIN=true
FRONTEND_ORIGIN=http://localhost:5173 
PUBLIC_API_URL=http://localhost:3000 

# Gmail SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_STARTTLS=false
# ต้องแก้อันนี้
SMTP_USER=your_sender@gmail.com
# ต้องแก้อันนี้: ใช้ Google App Password 16 ตัว ไม่ใช่รหัสผ่าน Gmail
SMTP_PASS=your_16_character_app_password
# ต้องแก้อันนี้ให้ตรงกับ SMTP_USER
SMTP_FROM="GRAD Tracking <your_sender@gmail.com>"
# เปิดเป็น true เฉพาะตอนทดสอบ เพื่อไม่ส่งหาอีเมลนักศึกษาจริง
EMAIL_TEST_MODE=true
# ต้องแก้อันนี้: เมื่อเปิดโหมดทดสอบ Email ทั้งหมดจะถูกส่งมาที่บัญชีนี้เพียงบัญชีเดียว
EMAIL_TEST_RECIPIENT=your_test_recipient@gmail.com
ENABLE_DEV_LOGIN=false
TZ=Asia/Bangkok
