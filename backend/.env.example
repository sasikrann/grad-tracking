# คัดลอกไฟล์นี้เป็น backend/.env แล้วเปลี่ยนค่าตัวอย่าง ห้าม Commit ไฟล์จริง

# PostgreSQL และ Port ของ Backend
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/grad_tracking
PORT=3000
TZ=Asia/Bangkok

# Google Sign-In และ Session - Client ID ต้องตรงกับ frontend/.env
ENABLE_DEV_LOGIN=false
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
JWT_SECRET=CHANGE_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
AUTH_COOKIE_SAME_SITE=lax

# เว็บไซต์ที่อนุญาตให้เรียก Backend
FRONTEND_ORIGIN=http://localhost:5173
# หากมีหลายเว็บไซต์ ให้เปิดบรรทัดนี้และคั่นแต่ละ Origin ด้วยเครื่องหมาย comma
# FRONTEND_ORIGINS=http://localhost:5173,https://grad.example.ac.th

# การส่ง Email ผ่าน Gmail SMTP - ดู docs/NOTIFICATION_SETUP.md
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_STARTTLS=false
SMTP_USER=your_sender@gmail.com
SMTP_PASS=your_16_character_app_password
SMTP_FROM="GRAD Tracking <your_sender@gmail.com>"
# ค่าด้านล่างไม่จำเป็นต้องเปิด หาก SMTP Server ไม่ได้กำหนดเป็นพิเศษ
# SMTP_HELO_NAME=localhost
# SMTP_TIMEOUT_MS=15000

# ระหว่างทดสอบ Email ทั้งหมดจะถูกส่งไปยังบัญชีนี้เพียงบัญชีเดียว
EMAIL_TEST_MODE=true
EMAIL_TEST_RECIPIENT=your_test_recipient@gmail.com

# บัญชีผู้ดูแลคนแรก ต้องเป็น Email @lamduan.mfu.ac.th
BOOTSTRAP_ADMIN_EMAIL=your_admin@lamduan.mfu.ac.th
BOOTSTRAP_ADMIN_NAME=System Administrator

# ใช้เฉพาะกรณีพิเศษที่ Host ใน DATABASE_URL ต้องถูกแทนที่ขณะเชื่อมต่อ
# DATABASE_HOST_OVERRIDE=database-host
