# คัดลอกไฟล์นี้เป็น .env.docker แล้วเปลี่ยนค่าตัวอย่าง ห้าม Commit ไฟล์จริง

# URL ที่ผู้ใช้เปิดเว็บไซต์ หากเปลี่ยน Port ต้องใส่ Port ใน APP_ORIGIN ด้วย
HTTP_PORT=80
APP_ORIGIN=http://localhost

# PostgreSQL - เปลี่ยนรหัสผ่านก่อนเปิดระบบ
POSTGRES_DB=grad_tracking
POSTGRES_USER=grad_tracking
POSTGRES_PASSWORD=CHANGE_TO_A_LONG_DATABASE_PASSWORD

# Google Sign-In และ Session - ดู docs/AUTHENTICATION_SETUP.md
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
JWT_SECRET=CHANGE_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
AUTH_COOKIE_SAME_SITE=lax

# บัญชีผู้ดูแลคนแรก ต้องเป็น Email @lamduan.mfu.ac.th
BOOTSTRAP_ADMIN_EMAIL=your_admin@lamduan.mfu.ac.th
BOOTSTRAP_ADMIN_NAME=System Administrator

# การส่ง Email ผ่าน Gmail SMTP - ดู docs/NOTIFICATION_SETUP.md
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_STARTTLS=false
SMTP_USER=your_sender@gmail.com
SMTP_PASS=your_google_app_password
SMTP_FROM=GRAD Tracking <your_sender@gmail.com>

# ระหว่างทดสอบให้คง true เพื่อส่ง Email ทั้งหมดไปยังผู้รับทดสอบเพียงคนเดียว
# เปลี่ยนเป็น false เมื่อพร้อมส่งหา Email ของนักศึกษาจริงเท่านั้น
EMAIL_TEST_MODE=true
EMAIL_TEST_RECIPIENT=your_test_recipient@gmail.com
